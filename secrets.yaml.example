# Copy this file to `secrets.yaml` (same folder as dashboard.yaml, inside the
# ESPHome add-on's /config/esphome/ directory) and fill in your real values.
# secrets.yaml is what dashboard.yaml's `!secret wifi_ssid` / `!secret
# wifi_password` references resolve to - keep it out of version control.

wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"
